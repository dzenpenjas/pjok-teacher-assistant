{
  "name": "pjok-teacher-assistant",
  "version": "1.0.0",
  "description": "PJOK Teacher Assistant membantu guru PJOK mengelola pembelajaran lapangan secara cepat dan offline.",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "build": "node scripts/build.js",
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "lint": "node --check server.js && node --check src/app.js",
    "android:sync": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "express": "^4.21.2",
    "html2pdf.js": "^0.14.0",
    "xlsx": "^0.18.5"
  }
}
